---
import { marked } from 'marked';
import Button from './Button.astro';
import siteConfig from '../data/site-config';

const hero = siteConfig.hero;
---

{
    (hero?.title || hero?.image?.src || hero?.text || (hero?.actions && hero.actions.length > 0)) && (
        <section class="w-full flex flex-col items-center gap-8 mb-16 sm:mb-24 sm:items-start">
            <div class="flex flex-col items-center gap-2 text-center sm:items-start">
              {hero.title && <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight text-accent">{hero.title.substring(0,14)}</h1>}
              {hero.title && <h1 class="text-2xl leading-tight font-serif font-medium sm:text-4xl sm:leading-tight text-main">{hero.title.substring(14)}</h1>}
            </div>
            <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start ">
              {hero.image?.src && (
                  <figure>
                      <img class="w-[70%] m-auto sm:w-full" src={hero.image.src} loading="lazy" decoding="async" alt={hero.image.alt || ''} width="210" height="280" />
                      {hero.image.caption && <figcaption class="mt-1.5 text-xs sm:text-sm">{hero.image.caption}</figcaption>}
                  </figure>
              )}
              {hero.text && <div class="max-w-[70%] prose prose-dante sm:prose-lg" set:html={marked.parse(hero.text)} />}
  
            </div>
            {hero.actions && hero.actions.length > 0 && (
                <div class="flex flex-wrap gap-4">
                    {hero.actions.map((action) => (
                        <Button href={action.href}>{action.text}</Button>
                    ))}
                </div>
            )}
        </section>
    )
}
